+import { describe, expect, it } from "vitest";
+import { getMinorUnitAmount, resolvePayableCurrency } from "./currency";
+
+describe("Phase 14 accepted-proposal currency invariants", () => {
+  it("keeps the accepted proposal currency when the visitor changes display currency", () => {
+    expect(resolvePayableCurrency("INR", "USD")).toEqual({
+      currency: "INR",
+      notice: "Your accepted proposal is payable in INR. The selected display currency is indicative only and does not change the amount due.",
+    });
+  });
+
+  it("does not change an accepted foreign-currency proposal when INR is selected for display", () => {
+    expect(resolvePayableCurrency("EUR", "INR").currency).toBe("EUR");
+  });
+
+  it("converts decimal quote amounts to minor units without binary floating-point rounding", () => {
+    expect(getMinorUnitAmount("1234.56", "INR")).toBe(123456);
+    expect(getMinorUnitAmount("1234.565", "USD")).toBe(123457);
+    expect(getMinorUnitAmount("16500", "JPY")).toBe(16500);
+  });
+
+  it("rejects accepted proposal currencies not enabled for Stripe instead of silently converting", () => {
+    expect(() => resolvePayableCurrency("THB", "INR")).toThrow(/Staff must review and reissue/);
+  });
+});
