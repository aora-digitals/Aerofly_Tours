+import { describe, expect, it } from "vitest";
+import { formatMoney, convertIndicativeFromInr, isSupportedCurrency } from "@/lib/currency";
+import { resolveTranslatedField, translate } from "@/i18n/translations";
+import { filterToursByKind } from "@/lib/tourClassification";
+
+describe("Phase 14 localization and indicative currency", () => {
+  it("returns English UI translations and Marathi labels", () => {
+    expect(translate("en", "nav_india")).toBe("India Tours");
+    expect(translate("mr", "nav_india")).toBe("भारत सहली");
+  });
+
+  it("falls back to English if Marathi is missing or not published", () => {
+    expect(resolveTranslatedField("mr", "Kerala Family Tour", "केरळ सहल", "draft")).toEqual({ value: "Kerala Family Tour", usedFallback: true });
+    expect(resolveTranslatedField("mr", "Kerala Family Tour", "केरळ सहल", "published")).toEqual({ value: "केरळ सहल", usedFallback: false });
+    expect(resolveTranslatedField("mr", "Visa information", "मसुदा व्हिसा मजकूर", "published", true)).toEqual({ value: "Visa information", usedFallback: true });
+  });
+
+  it("formats supported currencies and rounds indicative conversion to the currency minor unit", () => {
+    expect(formatMoney(1234.5, "INR")).toContain("1,234.50");
+    expect(convertIndicativeFromInr(100, 0.012, "USD")).toBe(1.2);
+    expect(convertIndicativeFromInr(100, 0.65, "JPY")).toBe(65);
+    expect(convertIndicativeFromInr(100, 0.65, "IDR")).toBe(65);
+  });
+
+  it("rejects unsupported currencies and invalid conversions", () => {
+    expect(isSupportedCurrency("EUR")).toBe(true);
+    expect(isSupportedCurrency("XYZ")).toBe(false);
+    expect(() => convertIndicativeFromInr(-1, 0.01, "USD")).toThrow();
+    expect(() => formatMoney(10, "XYZ")).toThrow();
+  });
+
+  it("filters domestic and international tours independently of display language or currency", () => {
+    const tours = [
+      { id: 1, tour_kind: "domestic", status: "published" },
+      { id: 2, tour_kind: "international", status: "published" },
+      { id: 3, tour_kind: "international", status: "draft" },
+    ];
+    expect(filterToursByKind(tours, "domestic").map((tour) => tour.id)).toEqual([1]);
+    expect(filterToursByKind(tours, "international").map((tour) => tour.id)).toEqual([2]);
+    expect(filterToursByKind(tours, "all").map((tour) => tour.id)).toEqual([1, 2]);
+  });
+});
