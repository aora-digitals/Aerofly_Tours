+  IF to_regprocedure('public.phase14_set_manual_currency_rates(jsonb,text,timestamp with time zone)') IS NULL THEN
+    RAISE EXCEPTION 'Missing manual currency-rate configuration RPC';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='phase14_lock_accepted_quote_snapshot' AND NOT tgisinternal) THEN
+    RAISE EXCEPTION 'Accepted quotation price snapshot lock trigger missing';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='phase14_lock_booking_snapshot' AND NOT tgisinternal) THEN
+    RAISE EXCEPTION 'Booking price snapshot lock trigger missing';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='phase14_lock_payment_snapshot' AND NOT tgisinternal) THEN
+    RAISE EXCEPTION 'Payment price snapshot lock trigger missing';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='phase14_lock_invoice_snapshot' AND NOT tgisinternal) THEN
+    RAISE EXCEPTION 'Invoice price snapshot lock trigger missing';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname='phase14_lock_refund_snapshot' AND NOT tgisinternal) THEN
+    RAISE EXCEPTION 'Refund price snapshot lock trigger missing';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='payments' AND column_name='currency_snapshot') THEN
+    RAISE EXCEPTION 'Payment currency snapshot column missing';
+  END IF;
+END $$;
+
+SELECT table_name, column_name, data_type
+FROM information_schema.columns
+WHERE table_schema='public'
+  AND ((table_name='tours' AND column_name IN ('tour_kind','base_currency','translations','translation_status'))
